<Project Sdk="Microsoft.NET.Sdk">

  <!-- System tray app (WinForms: much lighter than WPF for an always-running tray icon). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MonitorSwitcher</AssemblyName>
    <RootNamespace>MonitorSwitcher.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>

    <!-- Small idle footprint: workstation GC without the background GC thread. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- Single-file publish (exact commands are in .github/workflows/ci.yml). Measured on the reference
         machine, as window visible / idle private memory:
           framework-dependent (SelfContained=false): 0.5 MB exe, ~0.35 s, ~12 MB, needs the .NET Desktop Runtime
           standalone (SelfContained=true, PublishReadyToRun=true): 131 MB exe, ~0.2 s, ~15 MB
         Don't enable EnableCompressionInSingleFile (assemblies get unpacked into RAM: 86 MB), and don't
         combine ReadyToRun with a framework-dependent single file (crashes at startup on .NET 11.0.0).
         Note for editors: XML comments may not contain two hyphens in a row. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonitorSwitcher.Windows\MonitorSwitcher.Windows.csproj" />
  </ItemGroup>

</Project>
